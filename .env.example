# Copia este archivo a .env y completa los valores. .env nunca se sube al repositorio.

# --- Chatbot (opcional; apagado por defecto) ---
# El chat solo se activa si CHAT_ENABLED=true Y hay ANTHROPIC_API_KEY.
CHAT_ENABLED=false
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5
# CHAT_MAX_CARACTERES=500
# CHAT_MAX_TURNOS=30
# CHAT_HISTORIAL=12
# CHAT_RATE_LIMIT=20 per hour
# CHAT_MAX_TOKENS_RESPUESTA=400
# CHAT_MAX_RESERVAS_SESION=2

# --- Límite de peticiones ---
# En memoria el contador es por worker de Gunicorn (límite efectivo = límite x workers).
# Para uno exacto: RATELIMIT_STORAGE_URI=redis://localhost:6379
# RATELIMIT_STORAGE_URI=memory://
